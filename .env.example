# Auth.js secret used to encrypt JWT/session cookies.
# Generate locally with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth App credentials.
# Create one at https://github.com/settings/developers
# Authorization callback URL: https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Only members of this GitHub org can sign in.
ALLOWED_GITHUB_ORG=

# The repo whose release pipeline is shown (org/name).
TRACKED_REPO=org/mobile-app

# Long-lived release branch — where PRs are opened against and what the
# "Merged" and "Building" stages read from. Defaults to "main".
RELEASE_BRANCH=main

# "mock" (default) or "live".
# - mock: deterministic seeded pipeline, no network calls. Good for local UI work.
# - live: GitHub Source lane is fetched from the API using the signed-in user's
#   OAuth token (iOS + Android lanes still come from mock until those adapters
#   are implemented).
DATA_SOURCE=mock
